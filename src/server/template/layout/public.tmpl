{{define "public.tmpl"}}
<!DOCTYPE html>
<html lang="{{.Lang}}" dir="{{.Dir}}" class="theme-{{.Theme}}">
<head>{{template "head" .}}</head>
<body data-toast-duration="{{.ToastDuration}}" data-toast-warning-duration="{{.ToastWarningDuration}}">
<a class="skip-link" href="#main-content">{{t .Lang "nav.skip_to_content"}}</a>
<a class="skip-link" href="#navigation">{{t .Lang "nav.skip_to_nav"}}</a>
{{if ne .CurrentPath "/server/preferences"}}{{.ConsentBannerHTML}}{{end}}
{{.AnnouncementsHTML}}
<div id="toast-container" data-js-toast-container role="status" aria-live="polite" aria-atomic="true"></div>
{{template "site_header" .}}
{{template "page_content" .}}
{{template "public_footer" .}}
{{template "scripts" .}}
</body>
</html>
{{end}}
