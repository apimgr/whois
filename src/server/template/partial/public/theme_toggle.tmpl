{{define "theme_toggle"}}
<form method="post" action="{{path "/server/preferences"}}" class="theme-toggle-form">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <button id="theme-toggle" class="btn btn-ghost" type="submit" name="action" value="theme_toggle" title="{{t .Lang "theme.toggle"}}">
    {{t .Lang "theme.toggle"}}
  </button>
</form>
{{end}}
