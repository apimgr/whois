{{define "site_header"}}
<input type="checkbox" id="nav-toggle" class="nav-checkbox" aria-label="{{t .Lang "nav.toggle_navigation"}}">
<header class="header">
  <a href="{{path "/"}}" class="site-brand">{{.AppName}}</a>
  {{template "public_navigation" .}}
  <label for="nav-toggle" class="nav-toggle" aria-label="{{t .Lang "nav.toggle_navigation"}}">☰</label>
  <div class="header-actions">
    <a href="{{path "/server/preferences"}}" class="header-link" aria-label="{{t .Lang "nav.preferences"}}" title="{{t .Lang "nav.preferences"}}">
      <svg class="icon-preferences" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M19.14 12.94a7.49 7.49 0 0 0 0-1.88l2.03-1.58a.5.5 0 0 0 .12-.64l-1.92-3.32a.5.5 0 0 0-.6-.22l-2.39.96a7.28 7.28 0 0 0-1.63-.95l-.36-2.54A.49.49 0 0 0 13.9 2h-3.8a.49.49 0 0 0-.49.42l-.36 2.54a7.28 7.28 0 0 0-1.63.95l-2.39-.96a.5.5 0 0 0-.6.22L2.71 8.49a.5.5 0 0 0 .12.64l2.03 1.58a7.49 7.49 0 0 0 0 1.88l-2.03 1.58a.5.5 0 0 0-.12.64l1.92 3.32a.5.5 0 0 0 .6.22l2.39-.96c.5.4 1.05.72 1.63.95l.36 2.54a.49.49 0 0 0 .49.42h3.8a.49.49 0 0 0 .49-.42l.36-2.54c.58-.23 1.13-.55 1.63-.95l2.39.96a.5.5 0 0 0 .6-.22l1.92-3.32a.5.5 0 0 0-.12-.64zM12 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z"/></svg>
    </a>
    {{template "theme_toggle" .}}
  </div>
  {{if .HeaderHTML}}<div class="header-branding">{{.HeaderHTML}}</div>{{end}}
</header>
{{template "mobile_navigation" .}}
{{end}}
