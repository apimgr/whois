{{define "page_head"}}
<meta name="robots" content="noindex,nofollow">
<meta name="description" content="{{t .Lang "contact.title"}} — {{.Name}}">
<title>{{t .Lang "contact.title"}} — {{.Name}}</title>
{{end}}

{{define "page_content"}}
<main id="main-content">
  <div class="container container-sm">
    <article>
      <header class="page-header"><h1 class="page-title">{{t .Lang "contact.title"}}</h1></header>
      <p>{{t .Lang "contact.purpose_notice"}}</p>
      {{if .ErrorMessage}}<p class="alert alert-error" role="alert">{{.ErrorMessage}}</p>{{end}}
      {{if .Submitted}}<div class="alert alert-success" role="status"><p>{{.SuccessMessage}}</p></div>{{end}}
      {{if .Chooser}}
      <section class="section-card" aria-labelledby="contact-chooser-heading"><h2 id="contact-chooser-heading">{{t .Lang "contact.choose_type"}}</h2><ul>
        <li><a href="{{path "/server/contact"}}?type=abuse">{{t .Lang "contact.report_type_abuse"}}</a></li>
        <li><a href="{{path "/server/contact"}}?type=dmca">{{t .Lang "contact.report_type_dmca"}}</a></li>
        <li><a href="{{path "/server/contact"}}?type=privacy">{{t .Lang "contact.report_type_privacy"}}</a></li>
      </ul></section>
      <section class="section-card" aria-labelledby="security-heading"><h2 id="security-heading">{{t .Lang "contact.security_heading"}}</h2><p>{{t .Lang "contact.security_desc"}} <a href="{{path "/server/security"}}">{{t .Lang "contact.security_link"}}</a>.</p></section>
      <section class="section-card" aria-labelledby="abuse-heading"><h2 id="abuse-heading">{{t .Lang "contact.abuse_heading"}}</h2><p>{{t .Lang "contact.abuse_routing"}}{{if .AbuseEmail}} {{t .Lang "contact.abuse_email_prefix"}} <a href="mailto:{{.AbuseEmail}}">{{.AbuseEmail}}</a>.{{end}}</p></section>
      {{else}}
      <section class="section-card" aria-labelledby="contact-form-heading">
      <h2 id="contact-form-heading">{{if .SecurityMode}}{{t .Lang "contact.report_type_security"}}{{else if eq .Type "abuse"}}{{t .Lang "contact.report_type_abuse"}}{{else if eq .Type "dmca"}}{{t .Lang "contact.report_type_dmca"}}{{else}}{{t .Lang "contact.report_type_privacy"}}{{end}}</h2>
      <form method="post" action="{{path "/server/contact"}}" class="contact-form">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        {{if .Review}}
          <input type="hidden" name="review_token" value="{{.ReviewToken}}">
          {{range $key,$value := .Values}}{{if and (ne $key "csrf_token") (ne $key "step") (ne $key "form_token") (ne $key "review_token") (ne $key "captcha_id") (ne $key "captcha_answer")}}{{if ne $key "captcha_response"}}<input type="hidden" name="{{$key}}" value="{{$value}}">{{end}}{{end}}{{end}}
          <h3>{{t .Lang "contact.review_heading"}}</h3><p>{{t .Lang "contact.review_email"}}: <strong>{{index .Values "email"}}</strong></p><p>{{t .Lang "contact.review_type"}}: {{if .SecurityMode}}{{t .Lang "contact.report_type_security"}}{{else if eq .Type "abuse"}}{{t .Lang "contact.report_type_abuse"}}{{else if eq .Type "dmca"}}{{t .Lang "contact.report_type_dmca"}}{{else}}{{t .Lang "contact.report_type_privacy"}}{{end}}</p><p>{{t .Lang "contact.field_subject"}}: {{if .SecurityMode}}{{index .Values "summary"}}{{else}}{{index .Values "subject"}}{{end}}</p>
          <label><input type="checkbox" name="confirmed" value="true" required> {{t .Lang "contact.review_confirmation"}}</label>
          <button type="submit" name="step" value="confirm" class="btn-primary">{{t .Lang "contact.confirm"}}</button><button type="submit" name="step" value="edit">{{t .Lang "contact.edit"}}</button>
        {{else}}
          <input type="hidden" name="form_token" value="{{.FormToken}}">
          {{if .SecurityMode}}<input type="hidden" name="security_id" value="{{index .Values "security_id"}}">{{else}}<input type="hidden" name="type" value="{{.Type}}">{{end}}
          <div class="form-field"><label for="contact-name">{{t .Lang "contact.field_name"}} ({{t .Lang "contact.required"}})</label><input type="text" id="contact-name" name="name" required maxlength="100" value="{{index .Values "name"}}"></div>
          <div class="form-field"><label for="contact-email">{{t .Lang "contact.field_email"}} ({{t .Lang "contact.required"}})</label><input type="email" id="contact-email" name="email" required maxlength="254" value="{{index .Values "email"}}"></div>
          {{if .SecurityMode}}
            <div class="form-field"><label for="researcher_gpg">{{t .Lang "contact.researcher_gpg"}} ({{t .Lang "contact.optional"}})</label><textarea id="researcher_gpg" name="researcher_gpg" maxlength="16384">{{index .Values "researcher_gpg"}}</textarea></div>
            <div class="form-field"><label for="component">{{t .Lang "contact.affected_component"}} ({{t .Lang "contact.required"}})</label><input id="component" name="component" required maxlength="255" value="{{index .Values "component"}}"></div>
            <div class="form-field"><label for="endpoint">{{t .Lang "contact.affected_endpoint"}} ({{t .Lang "contact.optional"}})</label><input id="endpoint" name="endpoint" maxlength="2048" value="{{index .Values "endpoint"}}"></div>
            <div class="form-field"><label for="severity">{{t .Lang "contact.severity"}} ({{t .Lang "contact.required"}})</label><select id="severity" name="severity" required><option value="critical">{{t .Lang "security.severity.critical"}}</option><option value="high">{{t .Lang "security.severity.high"}}</option><option value="medium">{{t .Lang "security.severity.medium"}}</option><option value="low">{{t .Lang "security.severity.low"}}</option><option value="informational">{{t .Lang "security.severity.informational"}}</option></select></div>
            <div class="form-field"><label for="summary">{{t .Lang "contact.vulnerability_summary"}} ({{t .Lang "contact.required"}})</label><input id="summary" name="summary" required maxlength="200" value="{{index .Values "summary"}}"></div>
            <div class="form-field"><label for="steps">{{t .Lang "contact.steps_to_reproduce"}} ({{t .Lang "contact.required"}})</label><textarea id="steps" name="steps" required maxlength="10000">{{index .Values "steps"}}</textarea></div>
            <div class="form-field"><label for="impact">{{t .Lang "contact.impact"}} ({{t .Lang "contact.required"}})</label><textarea id="impact" name="impact" required maxlength="5000">{{index .Values "impact"}}</textarea></div>
            <div class="form-field"><label for="suggested_fix">{{t .Lang "contact.suggested_fix"}} ({{t .Lang "contact.optional"}})</label><textarea id="suggested_fix" name="suggested_fix" maxlength="5000">{{index .Values "suggested_fix"}}</textarea></div>
            <div class="form-field"><label for="disclosure_timeline_preference">{{t .Lang "contact.disclosure_timeline"}}</label><input id="disclosure_timeline_preference" name="disclosure_timeline_preference" type="number" value="90"></div>
            <div class="form-field"><label for="credit_preference">{{t .Lang "contact.credit_preference"}} ({{t .Lang "contact.required"}})</label><select id="credit_preference" name="credit_preference" required><option value="name">{{t .Lang "contact.credit_name"}}</option><option value="handle">{{t .Lang "contact.credit_handle_option"}}</option><option value="no">{{t .Lang "contact.credit_no"}}</option><option value="anon">{{t .Lang "contact.credit_anonymous"}}</option></select></div>
            <div class="form-field"><label for="credit_handle">{{t .Lang "contact.credit_handle_field"}}</label><input id="credit_handle" name="credit_handle" maxlength="100" value="{{index .Values "credit_handle"}}"></div>
            <label><input type="checkbox" name="cve_requested" value="true"> {{t .Lang "contact.cve_requested"}}</label>
            <label><input type="checkbox" name="coordinated_disclosure_agreement" value="true" required> {{t .Lang "contact.coordinated_disclosure"}} ({{t .Lang "contact.required"}})</label>
          {{else}}
            {{if eq .Type "abuse"}}
              <div class="form-field"><label for="reported_url">{{t .Lang "contact.reported_url"}} ({{t .Lang "contact.required"}})</label><input id="reported_url" name="reported_url" type="url" maxlength="2048" required><p>{{t .Lang "contact.site_url_example"}} {{.FQDN}}/...</p></div>
              <div class="form-field"><label for="reason">{{t .Lang "contact.reason"}} ({{t .Lang "contact.required"}})</label><select id="reason" name="reason" required><option value="illegal_content">{{t .Lang "contact.reason_illegal_content"}}</option><option value="terms_violation">{{t .Lang "contact.reason_terms_violation"}}</option><option value="harassment">{{t .Lang "contact.reason_harassment"}}</option><option value="malware_phishing">{{t .Lang "contact.reason_malware_phishing"}}</option><option value="other">{{t .Lang "contact.other"}}</option></select></div>
            {{else if eq .Type "dmca"}}
              <div class="form-field"><label for="reported_url">{{t .Lang "contact.reported_url"}} ({{t .Lang "contact.required"}})</label><input id="reported_url" name="reported_url" type="url" maxlength="2048" required></div>
              <div class="form-field"><label for="copyrighted_work">{{t .Lang "contact.copyrighted_work"}} ({{t .Lang "contact.required"}})</label><textarea id="copyrighted_work" name="copyrighted_work" maxlength="2000" required></textarea></div>
              <label><input type="checkbox" name="good_faith" value="true" required> {{t .Lang "contact.dmca_good_faith"}} ({{t .Lang "contact.required"}})</label>
              <label><input type="checkbox" name="accurate" value="true" required> {{t .Lang "contact.dmca_accuracy"}} ({{t .Lang "contact.required"}})</label>
              <div class="form-field"><label for="signature">{{t .Lang "contact.signature"}} ({{t .Lang "contact.required"}})</label><input id="signature" name="signature" maxlength="100" required></div>
            {{else}}
              <div class="form-field"><label for="request_kind">{{t .Lang "contact.request_kind"}} ({{t .Lang "contact.required"}})</label><select id="request_kind" name="request_kind" required><option value="access">{{t .Lang "contact.request_access"}}</option><option value="export">{{t .Lang "contact.request_export"}}</option><option value="deletion">{{t .Lang "contact.request_deletion"}}</option><option value="correction">{{t .Lang "contact.request_correction"}}</option><option value="opt_out">{{t .Lang "contact.request_opt_out"}}</option><option value="other">{{t .Lang "contact.other"}}</option></select></div>
            {{end}}
            <div class="form-field"><label for="contact-subject">{{t .Lang "contact.field_subject"}} ({{t .Lang "contact.required"}})</label><input type="text" id="contact-subject" name="subject" required maxlength="200" value="{{index .Values "subject"}}"></div>
            <div class="form-field"><label for="contact-message">{{t .Lang "contact.field_message"}} ({{t .Lang "contact.required"}})</label><textarea id="contact-message" name="message" rows="6" required maxlength="5000">{{index .Values "message"}}</textarea></div>
          {{end}}
          <div class="contact-honeypot" aria-hidden="true"><label for="contact-website">{{t .Lang "contact.honeypot_label"}}</label><input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off"></div>
          <div class="form-field captcha-field"><label for="contact-captcha">{{.CaptchaQuestion}}</label><input type="hidden" name="captcha_id" value="{{.CaptchaID}}"><input type="text" id="contact-captcha" name="captcha_answer" autocomplete="off" required></div>
          <button type="submit" name="step" value="submit" class="btn-primary">{{t .Lang "contact.review_report"}}</button>
        {{end}}
      </form>
      </section>
      <p>{{t .Lang "contact.security_desc"}} <a href="{{path "/server/security"}}">{{t .Lang "contact.security_link"}}</a>.</p>
      {{end}}
    </article>
  </div>
</main>
{{end}}

{{define "page_scripts"}}

{{end}}

{{template "public.tmpl" .}}
