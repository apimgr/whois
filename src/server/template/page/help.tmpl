{{define "page_head"}}
<meta name="description" content="{{t .Lang "help.title"}} — {{.Name}}">
<title>{{t .Lang "help.title"}} — {{.Name}}</title>
{{end}}

{{define "page_content"}}
{{if .ConsentRequired}}<p role="status"><a href="{{path "/server/preferences#privacy"}}">{{t .Lang "preferences.consent_required"}}</a></p>{{end}}

<main id="main-content">
  <div class="container container-md">
    <article>
      <header class="page-header"><h1 class="page-title">{{t .Lang "help.title"}}</h1><p class="page-lead">{{t .Lang "help.getting_started_intro"}}</p></header>

      <section id="getting-started" class="section-card" aria-labelledby="getting-started-heading">
        <h2 id="getting-started-heading">{{t .Lang "help.getting_started_heading"}}</h2>
        <p>{{t .Lang "help.getting_started_intro"}}</p>
        <div class="code-block" id="help-code-1"><pre><code>curl {{.APIBase}}/whois/example.com</code></pre><button type="button" class="copy-btn" data-copy-target="#help-code-1 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>

        <p>{{t .Lang "help.getting_started_response_label"}}</p>
        <div class="code-block" id="help-code-2"><pre><code>{
  "ok": true,
  "data": {
    "query": "example.com",
    "query_type": "domain",
    "source": "rdap",
    "registrar": "...",
    "created": "...",
    "expiry": "...",
    "nameservers": ["..."]
  }
}</code></pre><button type="button" class="copy-btn" data-copy-target="#help-code-2 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>

        <p>{{t .Lang "help.getting_started_ip_label"}}</p>
        <div class="code-block" id="help-code-3"><pre><code>curl {{.APIBase}}/whois/ip/8.8.8.8</code></pre><button type="button" class="copy-btn" data-copy-target="#help-code-3 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>

        <p>{{t .Lang "help.getting_started_asn_label"}}</p>
        <div class="code-block" id="help-code-4"><pre><code>curl {{.APIBase}}/whois/asn/AS15169</code></pre><button type="button" class="copy-btn" data-copy-target="#help-code-4 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>
      </section>

      <section id="features" class="section-card" aria-labelledby="features-heading">
        <h2 id="features-heading">{{t .Lang "help.features_heading"}}</h2>

        <h3>{{t .Lang "help.feature_domain_title"}}</h3>
        <p>{{t .Lang "help.feature_domain_desc"}}</p>
        <div class="code-block" id="help-code-5"><pre><code>curl {{.APIBase}}/whois/domain/example.com</code></pre><button type="button" class="copy-btn" data-copy-target="#help-code-5 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>

        <h3>{{t .Lang "help.feature_ip_title"}}</h3>
        <p>{{t .Lang "help.feature_ip_desc"}}</p>
        <div class="code-block" id="help-code-6"><pre><code>curl {{.APIBase}}/whois/ip/2001:4860:4860::8888</code></pre><button type="button" class="copy-btn" data-copy-target="#help-code-6 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>

        <h3>{{t .Lang "help.feature_asn_title"}}</h3>
        <p>{{t .Lang "help.feature_asn_desc"}}</p>
        <div class="code-block" id="help-code-7"><pre><code>curl {{.APIBase}}/whois/asn/AS13335</code></pre><button type="button" class="copy-btn" data-copy-target="#help-code-7 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>

        <h3>{{t .Lang "help.feature_validate_title"}}</h3>
        <p>{{t .Lang "help.feature_validate_desc"}}</p>
        <div class="code-block" id="help-code-8"><pre><code>curl {{.APIBase}}/whois/validate/example.com</code></pre><button type="button" class="copy-btn" data-copy-target="#help-code-8 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>

        <h3>{{t .Lang "help.feature_owner_search_title"}}</h3>
        <p>{{t .Lang "help.feature_owner_search_desc"}}</p>
        <div class="code-block" id="help-code-9"><pre><code>curl "{{.APIBase}}/whois/search?owner=Example+Org"</code></pre><button type="button" class="copy-btn" data-copy-target="#help-code-9 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>

        <h3>{{t .Lang "help.feature_bulk_title"}}</h3>
        <p>{{t .Lang "help.feature_bulk_desc"}}</p>
        <div class="code-block" id="help-code-10"><pre><code>curl -X POST -H "Authorization: Bearer &lt;server.token&gt;" \
  -d '{"queries":["example.com","8.8.8.8"]}' \
  {{.APIBase}}/whois/bulk</code></pre><button type="button" class="copy-btn" data-copy-target="#help-code-10 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>

        <h3>{{t .Lang "help.feature_servers_title"}}</h3>
        <p>{{t .Lang "help.feature_servers_desc"}}</p>
        <div class="code-block" id="help-code-11"><pre><code>curl {{.APIBase}}/whois-servers</code></pre><button type="button" class="copy-btn" data-copy-target="#help-code-11 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>

        <h3>{{t .Lang "help.feature_stats_title"}}</h3>
        <p>{{t .Lang "help.feature_stats_desc"}}</p>
        <div class="code-block" id="help-code-12"><pre><code>curl {{.APIBase}}/server/stats</code></pre><button type="button" class="copy-btn" data-copy-target="#help-code-12 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>

        <h3>{{t .Lang "help.feature_formats_title"}}</h3>
        <p>{{t .Lang "help.feature_formats_desc"}}</p>
        <div class="code-block" id="help-code-13"><pre><code>curl -H "Accept: text/plain" {{.APIBase}}/whois/example.com
curl -H "Accept: application/json" {{.APIBase}}/whois/example.com</code></pre><button type="button" class="copy-btn" data-copy-target="#help-code-13 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>
      </section>

      <section class="section-card api-docs" aria-labelledby="api-docs-heading">
        <h2 id="api-docs-heading">{{t .Lang "help.api_docs_heading"}}</h2>
        <p>{{t .Lang "help.api_docs_desc"}}</p>
        <ul>
          <li><a href="{{path "/server/docs/swagger"}}">{{t .Lang "help.api_docs_swagger_label"}}</a> - {{t .Lang "help.api_docs_swagger_desc"}}</li>
          <li><a href="{{path "/server/docs/graphql"}}">{{t .Lang "help.api_docs_graphql_label"}}</a> - {{t .Lang "help.api_docs_graphql_desc"}}</li>
        </ul>
      </section>

      {{ if and .TorEnabled .TorRunning }}
      <section id="tor-access" class="section-card tor-access" aria-labelledby="tor-access-heading">
        <h2 id="tor-access-heading">{{t .Lang "help.tor_heading"}}</h2>
        <p>{{t .Lang "help.tor_intro"}}</p>

        <h3>{{t .Lang "help.tor_address_heading"}}</h3>
        <div class="code-block">
          <code class="code-content">{{.OnionAddr}}</code>
          <button type="button" class="copy-btn" data-copy="{{.OnionAddr}}" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "help.tor_copy_label"}}">
            <span class="copy-icon" aria-hidden="true">&#128203;</span>
            <span class="copy-text" aria-live="polite">{{t .Lang "help.tor_copy_text"}}</span>
          </button>
        </div>

        <h3>{{t .Lang "help.tor_connect_heading"}}</h3>
        <ol>
          <li>{{t .Lang "help.tor_step_download"}} <a href="https://www.torproject.org/download/" target="_blank" rel="noopener">{{t .Lang "help.tor_browser_link"}}</a></li>
          <li>{{t .Lang "help.tor_step_open"}}</li>
          <li>{{t .Lang "help.tor_step_paste"}}</li>
        </ol>

        <p class="note">{{t .Lang "help.tor_note"}}</p>
      </section>
      {{ end }}

      {{ if and .I2PRunning .I2PAddr }}
      <section id="i2p-access" class="section-card" aria-labelledby="i2p-access-heading">
        <h2 id="i2p-access-heading">{{t .Lang "help.i2p_heading"}}</h2>
        <p>{{t .Lang "help.i2p_intro"}}</p>
        <div class="code-block">
          <code class="code-content selectable-text">{{.I2PAddr}}</code>
          <button type="button" class="copy-btn" data-copy="{{.I2PAddr}}" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}">
            <span class="copy-icon" aria-hidden="true">&#128203;</span>
            <span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span>
          </button>
        </div>
      </section>
      {{ end }}

      <section id="faq" class="section-card" aria-labelledby="faq-heading">
        <h2 id="faq-heading">{{t .Lang "help.faq_heading"}}</h2>

        <h3>{{t .Lang "help.faq_q_apikey"}}</h3>
        <p>{{t .Lang "help.faq_a_apikey"}}</p>

        <h3>{{t .Lang "help.faq_q_ratelimit"}}</h3>
        <p>{{t .Lang "help.faq_a_ratelimit"}}</p>

        <h3>{{t .Lang "help.faq_q_source"}}</h3>
        <p>{{t .Lang "help.faq_a_source"}}</p>

        <h3>{{t .Lang "help.faq_q_bulk"}}</h3>
        <p>{{t .Lang "help.faq_a_bulk"}}</p>

        <h3>{{t .Lang "help.faq_q_owner_search"}}</h3>
        <p>{{t .Lang "help.faq_a_owner_search"}}</p>
      </section>

      <section id="troubleshooting" class="section-card" aria-labelledby="troubleshooting-heading">
        <h2 id="troubleshooting-heading">{{t .Lang "help.troubleshooting_heading"}}</h2>

        <h3>{{t .Lang "help.trouble_q_429"}}</h3>
        <p>{{t .Lang "help.trouble_a_429"}}</p>

        <h3>{{t .Lang "help.trouble_q_notfound"}}</h3>
        <p>{{t .Lang "help.trouble_a_notfound"}}</p>

        <h3>{{t .Lang "help.trouble_q_stale"}}</h3>
        <p>{{t .Lang "help.trouble_a_stale"}}</p>

        <h3>{{t .Lang "help.trouble_q_bulk_auth"}}</h3>
        <p>{{t .Lang "help.trouble_a_bulk_auth"}}</p>
      </section>

      {{ if .CustomHTML }}
      <section id="additional-info" class="section-card" aria-labelledby="additional-info-heading">
        <h2 id="additional-info-heading">{{t .Lang "help.additional_info_heading"}}</h2>
        {{ .CustomHTML | markdownToHTMLSection }}
      </section>
      {{ end }}
      <section class="section-card" aria-labelledby="more-help-heading">
        <h2 id="more-help-heading">{{t .Lang "help.more_pages"}}</h2>
        <ul class="hub-list" role="list">
          {{range .MorePages}}<li class="hub-item"><a class="hub-link" href="{{path .Path}}"><span class="hub-title">{{t $.Lang .TitleKey}}</span><span class="hub-desc">{{t $.Lang .Description}}</span></a></li>{{end}}
        </ul>
      </section>
    </article>
  </div>
</main>
{{end}}

{{define "page_scripts"}}

{{end}}

{{template "public.tmpl" .}}
