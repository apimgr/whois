{{define "page_head"}}
<title>{{.Name}}</title>
{{end}}

{{define "page_content"}}
<main id="main-content">
    <div class="container container-md">
      <header class="page-header"><h1 class="page-title">{{.Name}}</h1></header>
      <section class="card section-card" aria-labelledby="response-heading">
        <h2 id="response-heading">{{t .Lang "common.details"}}</h2>
        <p>{{.Content}}</p>
      </section>
    </div>
  </main>
{{end}}

{{define "page_scripts"}}

{{end}}

{{template "public.tmpl" .}}
