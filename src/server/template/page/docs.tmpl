{{define "page_head"}}
<meta name="description" content="{{.Name}} {{t .Lang "docs.meta_description_suffix"}}">
<title>{{t .Lang "docs.title_prefix"}} — {{.Name}}</title>
{{end}}

{{define "page_content"}}
{{if .ConsentRequired}}<p role="status"><a href="{{path "/server/preferences#privacy"}}">{{t .Lang "preferences.consent_required"}}</a></p>{{end}}

<main id="main-content">
  <div class="container container-md">
    <header class="page-header">
      <h1 class="page-title">{{.Name}} {{t .Lang "docs.title_prefix"}}</h1>
      <p class="page-lead">{{t .Lang "docs.subtitle"}}</p>
    </header>

    <aside aria-label="{{t .Lang "docs.toc_heading"}}">
      <nav aria-label="{{t .Lang "docs.toc_heading"}}">
        <p>{{t .Lang "docs.toc_heading"}}</p>
        <ul>
          <li><a href="#base-url">{{t .Lang "docs.toc_base_url"}}</a></li>
          <li><a href="#auth">{{t .Lang "docs.toc_auth"}}</a></li>
          <li><a href="#formats">{{t .Lang "docs.toc_formats"}}</a></li>
          <li><a href="#endpoints">{{t .Lang "docs.toc_endpoints"}}</a></li>
          <li><a href="#response-schema">{{t .Lang "docs.toc_response_schema"}}</a></li>
          <li><a href="#rate-limits">{{t .Lang "docs.toc_rate_limits"}}</a></li>
          <li><a href="#errors">{{t .Lang "docs.toc_errors"}}</a></li>
        </ul>
      </nav>
    </aside>

    <article>

      <section class="section-card" id="base-url" aria-labelledby="h-base-url">
        <h2 id="h-base-url">{{t .Lang "docs.toc_base_url"}}</h2>
        <div class="code-block" id="doc-code-1"><pre><code>/api/{{.APIVersion}}</code></pre><button type="button" class="copy-btn" data-copy-target="#doc-code-1 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>
        <p>{{t .Lang "docs.base_url_desc_prefix"}} <code>/api/{{.APIVersion}}</code>.</p>
      </section>

      <section class="section-card" id="auth" aria-labelledby="h-auth">
        <h2 id="h-auth">{{t .Lang "docs.toc_auth"}}</h2>
        <p>
          {{t .Lang "docs.auth_desc1"}}
        </p>
        <div class="code-block" id="doc-code-2"><pre><code>Authorization: Bearer adm_&lt;operator-token&gt; or own_&lt;owner-token&gt;</code></pre><button type="button" class="copy-btn" data-copy-target="#doc-code-2 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>
        <p>
          {{t .Lang "docs.auth_desc2_prefix"}}
          <code>server.yml</code>. {{t .Lang "docs.auth_desc2_suffix"}}
        </p>
      </section>

      <section class="section-card" id="formats" aria-labelledby="h-formats">
        <h2 id="h-formats">{{t .Lang "docs.toc_formats"}}</h2>
        <p>
          {{t .Lang "docs.formats_desc"}}
        </p>
        <div class="table-wrapper" role="region" aria-label="{{t .Lang "docs.toc_formats"}}" tabindex="0">
          <table class="data-table">
            <thead>
              <tr><th scope="col">{{t .Lang "docs.table_format"}}</th><th scope="col">{{t .Lang "docs.table_accept_header"}}</th><th scope="col">{{t .Lang "docs.table_query_param"}}</th></tr>
            </thead>
            <tbody>
              <tr><td>JSON (default)</td><td><code>application/json</code></td><td><code>?format=json</code></td></tr>
              <tr><td>XML</td><td><code>application/xml</code></td><td><code>?format=xml</code></td></tr>
              <tr><td>Plain text</td><td><code>text/plain</code></td><td><code>?format=text</code></td></tr>
              <tr><td>HTML</td><td><code>text/html</code></td><td><code>?format=html</code></td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="section-card" id="endpoints" aria-labelledby="h-endpoints">
        <h2 id="h-endpoints">{{t .Lang "docs.toc_endpoints"}}</h2>

          <div>
          <div class="cluster gap-2">
            <span>GET</span>
            <code class="break-anywhere">/server/healthz</code>
          </div>
          <p>{{t .Lang "docs.endpoint_healthz_desc"}}</p>
        </div>

        <div>
          <div class="cluster gap-2">
            <span>GET</span>
            <code class="break-anywhere">/api/{{.APIVersion}}/whois/{query}</code>
          </div>
          <p>{{t .Lang "docs.endpoint_whois_desc"}}</p>
          <div class="code-block" id="doc-code-3"><pre><code>GET /api/{{.APIVersion}}/whois/example.com
GET /api/{{.APIVersion}}/whois/8.8.8.8
GET /api/{{.APIVersion}}/whois/AS15169</code></pre><button type="button" class="copy-btn" data-copy-target="#doc-code-3 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>
        </div>

        <div>
          <div class="cluster gap-2">
            <span>GET</span>
            <code class="break-anywhere">/api/{{.APIVersion}}/whois/domain/{domain}</code>
          </div>
          <p>{{t .Lang "docs.endpoint_domain_desc"}}</p>
          <div class="code-block" id="doc-code-4"><pre><code>GET /api/{{.APIVersion}}/whois/domain/github.com</code></pre><button type="button" class="copy-btn" data-copy-target="#doc-code-4 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>
        </div>

        <div>
          <div class="cluster gap-2">
            <span>GET</span>
            <code class="break-anywhere">/api/{{.APIVersion}}/whois/ip/{ip}</code>
          </div>
          <p>{{t .Lang "docs.endpoint_ip_desc"}}</p>
          <div class="code-block" id="doc-code-5"><pre><code>GET /api/{{.APIVersion}}/whois/ip/1.1.1.1
GET /api/{{.APIVersion}}/whois/ip/2001:4860:4860::8888</code></pre><button type="button" class="copy-btn" data-copy-target="#doc-code-5 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>
        </div>

        <div>
          <div class="cluster gap-2">
            <span>GET</span>
            <code class="break-anywhere">/api/{{.APIVersion}}/whois/asn/{asn}</code>
          </div>
          <p>{{t .Lang "docs.endpoint_asn_desc"}}</p>
          <div class="code-block" id="doc-code-6"><pre><code>GET /api/{{.APIVersion}}/whois/asn/AS13335</code></pre><button type="button" class="copy-btn" data-copy-target="#doc-code-6 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>
        </div>

        <div>
          <div class="cluster gap-2">
            <span>GET</span>
            <code class="break-anywhere">/api/{{.APIVersion}}/whois/validate/{query}</code>
          </div>
          <p>{{t .Lang "docs.endpoint_validate_desc"}}</p>
          <div class="code-block" id="doc-code-7"><pre><code>GET /api/{{.APIVersion}}/whois/validate/example.com

{
  "ok": true,
  "data": {
    "query": "example.com",
    "valid": true,
    "type": "domain"
  }
}</code></pre><button type="button" class="copy-btn" data-copy-target="#doc-code-7 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>
        </div>

        <div>
          <div class="cluster gap-2">
            <span>POST</span>
            <code class="break-anywhere">/api/{{.APIVersion}}/whois/bulk</code>
            <span class="badge badge-warning">{{t .Lang "docs.auth_required_badge"}}</span>
          </div>
          <p>{{t .Lang "docs.endpoint_bulk_desc"}}</p>
          <div class="code-block" id="doc-code-8"><pre><code>POST /api/{{.APIVersion}}/whois/bulk
Authorization: Bearer adm_&lt;server-token&gt;
Content-Type: application/json

{
  "queries": ["example.com", "8.8.8.8", "AS15169"]
}</code></pre><button type="button" class="copy-btn" data-copy-target="#doc-code-8 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>
        </div>

        <div>
          <div class="cluster gap-2">
            <span>GET</span>
            <code class="break-anywhere">/api/{{.APIVersion}}/whois-servers</code>
          </div>
          <p>{{t .Lang "docs.endpoint_servers_desc"}}</p>
        </div>

        <div>
          <div class="cluster gap-2">
            <span>GET</span>
            <code class="break-anywhere">/api/{{.APIVersion}}/server/stats</code>
          </div>
          <p>{{t .Lang "docs.endpoint_stats_desc"}}</p>
        </div>

      </section>

      <section class="section-card" id="response-schema" aria-labelledby="h-schema">
        <h2 id="h-schema">{{t .Lang "docs.toc_response_schema"}}</h2>

        <h3>{{t .Lang "common.success"}}</h3>
        <div class="code-block" id="doc-code-9"><pre><code>{
  "ok": true,
  "data": {
    "query":     "example.com",
    "type":      "domain",
    "server":    "whois.iana.org",
    "timestamp": "2026-05-28T14:00:00Z",
    "raw":       "Domain Name: EXAMPLE.COM\n..."
  }
}</code></pre><button type="button" class="copy-btn" data-copy-target="#doc-code-9 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>

        <h3>{{t .Lang "common.error"}}</h3>
        <div class="code-block" id="doc-code-10"><pre><code>{
  "ok":      false,
  "error":   "VALIDATION_FAILED",
  "message": "Invalid domain format"
}</code></pre><button type="button" class="copy-btn" data-copy-target="#doc-code-10 code" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy"}}"><span class="copy-icon" aria-hidden="true">&#128203;</span><span class="copy-text" aria-live="polite">{{t .Lang "preferences.copy"}}</span></button></div>
      </section>

      <section class="section-card" id="rate-limits" aria-labelledby="h-rate">
        <h2 id="h-rate">{{t .Lang "docs.toc_rate_limits"}}</h2>
        <div class="table-wrapper" role="region" aria-label="{{t .Lang "docs.toc_rate_limits"}}" tabindex="0">
          <table class="data-table">
            <thead>
              <tr><th scope="col">{{t .Lang "docs.table_limit"}}</th><th scope="col">{{t .Lang "docs.requests_per_window"}}</th></tr>
            </thead>
            <tbody>
              {{range .RateLimits}}<tr><td>{{t $.Lang .Label}}</td><td>{{.Requests}} / {{.Window}} {{t $.Lang "docs.seconds"}}</td></tr>{{end}}
            </tbody>
          </table>
        </div>
        <p>{{t .Lang "docs.rate_limit_note"}}</p>
      </section>

      <section class="section-card" id="errors" aria-labelledby="h-errors">
        <h2 id="h-errors">{{t .Lang "docs.toc_errors"}}</h2>
        <div class="table-wrapper" role="region" aria-label="{{t .Lang "docs.toc_errors"}}" tabindex="0">
          <table class="data-table">
            <thead>
              <tr><th scope="col">{{t .Lang "docs.table_code"}}</th><th scope="col">{{t .Lang "docs.table_http_status"}}</th><th scope="col">{{t .Lang "docs.table_meaning"}}</th></tr>
            </thead>
            <tbody>
              <tr><td><code>BAD_REQUEST</code></td><td>400</td><td>{{t .Lang "docs.error_bad_request_meaning"}}</td></tr>
              <tr><td><code>VALIDATION_FAILED</code></td><td>400</td><td>{{t .Lang "docs.error_validation_failed_meaning"}}</td></tr>
              <tr><td><code>UNAUTHORIZED</code></td><td>401</td><td>{{t .Lang "docs.error_unauthorized_meaning"}}</td></tr>
              <tr><td><code>FORBIDDEN</code></td><td>403</td><td>{{t .Lang "docs.error_forbidden_meaning"}}</td></tr>
              <tr><td><code>NOT_FOUND</code></td><td>404</td><td>{{t .Lang "docs.error_not_found_meaning"}}</td></tr>
              <tr><td><code>RATE_LIMITED</code></td><td>429</td><td>{{t .Lang "docs.error_rate_limited_meaning"}}</td></tr>
              <tr><td><code>SERVER_ERROR</code></td><td>500</td><td>{{t .Lang "docs.error_server_error_meaning"}}</td></tr>
              <tr><td><code>MAINTENANCE</code></td><td>503</td><td>{{t .Lang "docs.error_maintenance_meaning"}}</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <nav class="mt-2">
        <a href="{{path "/"}}" class="btn btn-primary">{{t .Lang "common.new_lookup"}} &rarr;</a>
      </nav>

    </article>
  </div>
</main>
{{end}}

{{define "page_scripts"}}

{{end}}

{{template "public.tmpl" .}}
