{{define "page_head"}}
<meta name="description" content="{{t .Lang "terms.title"}} — {{.Name}}">
<title>{{t .Lang "terms.title"}} — {{.Name}}</title>
{{end}}

{{define "page_content"}}
{{if .ConsentRequired}}<p role="status"><a href="{{path "/server/preferences#privacy"}}">{{t .Lang "preferences.consent_required"}}</a></p>{{end}}

<main id="main-content">
  <div class="container container-md">
    <article>
      <header class="page-header"><h1 class="page-title">{{t .Lang "terms.title"}}</h1></header>

      <section id="acceptance" class="card section-card" aria-labelledby="acceptance-heading">
        <h2 id="acceptance-heading">{{t .Lang "terms.acceptance_heading"}}</h2>
        <p>{{t .Lang "terms.acceptance_desc"}} {{.Name}} {{t .Lang "terms.acceptance_suffix"}}</p>
      </section>

      <section id="terms-content" class="card section-card" aria-labelledby="terms-content-heading">
        <h2 id="terms-content-heading">{{t .Lang "common.details"}}</h2>
        {{ .Content | markdownToHTMLSection }}
      </section>
    </article>
  </div>
</main>
{{end}}

{{define "page_scripts"}}

{{end}}

{{template "public.tmpl" .}}
