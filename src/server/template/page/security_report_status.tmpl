{{define "page_head"}}
<meta name="robots" content="noindex,nofollow">
<title>{{t .Lang "security.status_title"}} — {{.AppName}}</title>
{{end}}

{{define "page_content"}}
<main id="main-content">
  <div class="container container-md">
    <header class="page-header"><h1 class="page-title">{{t .Lang "security.status_title"}}</h1><p class="page-lead">{{t .Lang "security.status_description"}}</p></header>
    <article class="section-card" aria-labelledby="security-status-heading">
      <h2 id="security-status-heading">{{t .Lang "security.tracking_id"}}</h2>
      <p>{{t .Lang "security.tracking_id"}}: <code>{{.TrackingID}}</code></p>
      <p>{{t .Lang "security.status_label"}}: <strong>{{t .Lang (printf "security.report_status.%s" .Status)}}</strong></p>
      {{if .Comment}}<section aria-labelledby="security-status-comment"><h3 id="security-status-comment">{{t .Lang "security.maintainer_comment"}}</h3><p>{{.Comment}}</p></section>{{end}}
      {{if .DisclosureDate}}<p>{{t .Lang "security.expected_disclosure"}}: {{.DisclosureDate}}</p>{{end}}
    </article>
  </div>
</main>
{{end}}

{{define "page_scripts"}}

{{end}}

{{template "public.tmpl" .}}
