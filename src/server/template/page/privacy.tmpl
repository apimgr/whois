{{define "page_head"}}
<meta name="description" content="{{t .Lang "privacy.title"}} — {{.Name}}">
<title>{{t .Lang "privacy.title"}} — {{.Name}}</title>
{{end}}

{{define "page_content"}}
{{if .ConsentRequired}}<p role="status"><a href="{{path "/server/preferences#privacy"}}">{{t .Lang "preferences.consent_required"}}</a></p>{{end}}

<main id="main-content">
  <div class="container container-md">
    <article>
      <header class="page-header">
        <h1 class="page-title">{{t .Lang "privacy.title"}}</h1>
        <p class="page-lead">{{t .Lang "privacy.description"}}</p>
        <p>{{t .Lang "privacy.last_updated"}}: {{.Footer.BuildDatetime}}</p>
      </header>

      <section id="summary" class="section-card" aria-labelledby="summary-heading">
        <h2 id="summary-heading">{{t .Lang "privacy.summary_heading"}}</h2>
          <div class="stack">
          <div class="alert alert-info">
            <span class="icon" aria-hidden="true">&#128274;</span>
            <strong>{{t .Lang "privacy.point_stored_title"}}</strong>
            <p>{{t .Lang "privacy.point_stored_desc"}}</p>
          </div>
          {{ if .DataSold }}
          <div class="alert alert-warning">
            <span class="icon" aria-hidden="true">&#9888;&#65039;</span>
            <strong>{{t .Lang "privacy.point_sold_title"}}</strong>
            <p>{{t .Lang "privacy.point_sold_desc"}} <a href="#ccpa-opt-out">{{t .Lang "privacy.point_sold_link"}}</a>.</p>
          </div>
          {{ else }}
          <div class="alert alert-info">
            <span class="icon" aria-hidden="true">&#128683;</span>
            <strong>{{t .Lang "privacy.point_not_sold_title"}}</strong>
            <p>{{t .Lang "privacy.point_not_sold_desc"}}</p>
          </div>
          {{ end }}
          <div class="alert alert-info">
            <span class="icon" aria-hidden="true">&#127918;&#65039;</span>
            <strong>{{t .Lang "privacy.point_control_title"}}</strong>
            <p>{{t .Lang "privacy.point_control_desc"}}</p>
          </div>
        </div>
      </section>

      <section id="cookies" class="section-card" aria-labelledby="cookies-heading">
        <h2 id="cookies-heading">{{t .Lang "privacy.cookies_heading"}}</h2>
        <p>{{t .Lang "privacy.cookies_intro"}}</p>

        <h3>{{t .Lang "privacy.cookies_essential_title"}}</h3>
        <p>{{.EssentialCookieDesc}}</p>

        <h3>{{t .Lang "privacy.cookies_preferences_title"}}</h3>
        <p>{{.PreferencesCookieDesc}}</p>

        <h3>{{t .Lang "privacy.cookies_analytics_title"}}</h3>
        {{ if .TrackingType }}
        <p>{{.AnalyticsDesc}}</p>
        <p>{{t .Lang "privacy.cookies_analytics_provider_prefix"}} <strong>{{.TrackingTypeName}}</strong> {{t .Lang "privacy.cookies_analytics_provider_suffix"}}</p>
        {{ else }}
        <p>{{t .Lang "privacy.cookies_analytics_none"}}</p>
        {{ end }}

        <div class="form-actions">
          <button type="button" data-action="cookie-preferences">{{t .Lang "privacy.manage_cookies_button"}}</button>
        </div>
      </section>

      <section id="data-collection" class="section-card" aria-labelledby="data-collection-heading">
        <h2 id="data-collection-heading">{{t .Lang "privacy.data_collection_heading"}}</h2>
        {{ .DataCollection | markdownToHTMLSection }}
      </section>

      <section id="data-usage" class="section-card" aria-labelledby="data-usage-heading">
        <h2 id="data-usage-heading">{{t .Lang "privacy.data_usage_heading"}}</h2>
        {{ .DataUsage | markdownToHTMLSection }}
      </section>

      <section id="data-security" class="section-card" aria-labelledby="data-security-heading">
        <h2 id="data-security-heading">{{t .Lang "privacy.data_security_heading"}}</h2>
        {{ .DataSecurity | markdownToHTMLSection }}
      </section>

      <section id="data-storage" class="section-card" aria-labelledby="data-storage-heading">
        <h2 id="data-storage-heading">{{t .Lang "privacy.data_storage_heading"}}</h2>
        <p><strong>{{t .Lang "privacy.data_storage_intro"}}</strong></p>

        <h3>{{t .Lang "privacy.data_shared_when_heading"}}</h3>
        <p>{{t .Lang "privacy.data_shared_when_intro"}}</p>
        <ul>
          {{ range .Sharing }}
          <li><strong>{{ .Condition | humanize }}:</strong> {{ .When }} - {{ .Data }}</li>
          {{ end }}
        </ul>

        <p><strong>{{t .Lang "privacy.data_shared_all_cases"}}</strong></p>
        <ul>
          <li>{{t .Lang "privacy.data_shared_necessary"}}</li>
          <li>{{t .Lang "privacy.data_shared_opt_out"}}</li>
          {{ if .DataSold }}
          <li>{{t .Lang "privacy.data_shared_may_sell"}} <a href="#ccpa-opt-out">{{t .Lang "privacy.ccpa_heading"}}</a>.</li>
          {{ else }}
          <li>{{t .Lang "privacy.data_shared_never_sell"}}</li>
          {{ end }}
        </ul>
      </section>

      <section id="data-retention" class="section-card" aria-labelledby="data-retention-heading">
        <h2 id="data-retention-heading">{{t .Lang "privacy.data_retention_heading"}}</h2>
        <p>{{.RetentionPeriod}}</p>
      </section>

      <section id="third-parties" class="section-card" aria-labelledby="third-parties-heading">
        <h2 id="third-parties-heading">{{t .Lang "privacy.third_parties_heading"}}</h2>
        {{ if .ThirdPartyServices }}
        <p>{{t .Lang "privacy.third_parties_intro"}}</p>
        <div class="table-wrapper"><table class="data-table">
          <thead>
            <tr>
              <th scope="col">{{t .Lang "privacy.third_party_col_name"}}</th>
              <th scope="col">{{t .Lang "privacy.third_party_col_purpose"}}</th>
              <th scope="col">{{t .Lang "privacy.third_party_col_data"}}</th>
              <th scope="col">{{t .Lang "privacy.third_party_col_policy"}}</th>
            </tr>
          </thead>
          <tbody>
            {{ range .ThirdPartyServices }}
            <tr>
              <td>{{ .Name }}</td>
              <td>{{ .Purpose }}</td>
              <td>{{ .DataSent }}</td>
              <td><a href="{{ .PolicyURL }}" target="_blank" rel="noopener noreferrer">{{t $.Lang "privacy.third_party_policy_link"}}</a></td>
            </tr>
            {{ end }}
          </tbody>
        </table></div>
        {{ else }}
        <p><strong>{{t .Lang "privacy.third_parties_none"}}</strong></p>
        <p>{{t .Lang "privacy.third_parties_analytics_note"}}</p>
        {{ end }}
      </section>

      <section id="your-rights" class="section-card" aria-labelledby="your-rights-heading">
        <h2 id="your-rights-heading">{{t .Lang "privacy.your_rights_heading"}}</h2>
        <p>{{t .Lang "privacy.your_rights_intro"}}</p>
        <ul>
          <li><strong>{{t .Lang "privacy.rights_access_title"}}:</strong> {{t .Lang "privacy.rights_access_desc"}}</li>
          {{ if .ExportAvailable }}
          <li><strong>{{t .Lang "privacy.rights_export_title"}}:</strong> {{t .Lang "privacy.rights_export_desc"}}</li>
          {{ end }}
          {{ if .DeletionAvailable }}
          <li><strong>{{t .Lang "privacy.rights_deletion_title"}}:</strong> {{t .Lang "privacy.rights_deletion_desc"}}</li>
          {{ end }}
          <li><strong>{{t .Lang "privacy.rights_correction_title"}}:</strong> {{t .Lang "privacy.rights_correction_desc"}}</li>
          <li><strong>{{t .Lang "privacy.rights_cookie_control_title"}}:</strong> <button type="button" class="btn btn-ghost btn-sm" data-action="cookie-preferences">{{t .Lang "privacy.rights_cookie_control_desc"}}</button></li>
        </ul>
      </section>

      {{ if .DataSold }}
      <section id="ccpa-opt-out" class="section-card" aria-labelledby="ccpa-heading">
        <h2 id="ccpa-heading">{{t .Lang "privacy.ccpa_heading"}}</h2>
        <p>{{t .Lang "privacy.ccpa_intro"}}</p>
        <ul>
          <li><strong>{{t .Lang "privacy.ccpa_right_know_title"}}</strong> {{t .Lang "privacy.ccpa_right_know_desc"}}</li>
          <li><strong>{{t .Lang "privacy.ccpa_right_deletion_title"}}</strong> {{t .Lang "privacy.ccpa_right_deletion_desc"}}</li>
          <li><strong>{{t .Lang "privacy.ccpa_right_opt_out_title"}}</strong> {{t .Lang "privacy.ccpa_right_opt_out_desc"}}</li>
          <li><strong>{{t .Lang "privacy.ccpa_right_nondiscrimination_title"}}</strong> {{t .Lang "privacy.ccpa_right_nondiscrimination_desc"}}</li>
        </ul>

        <div class="stack">
          <h3>{{t .Lang "privacy.ccpa_box_heading"}}</h3>
          <p>{{t .Lang "privacy.ccpa_box_desc"}}</p>
          {{ if .CCPAOptedOut }}
          <div class="status-banner status-ok">
            <span class="status-icon" aria-hidden="true">&#10003;</span>
            <span>{{t .Lang "privacy.ccpa_opted_out_status"}}</span>
          </div>
          <form method="post" action="{{path "/server/ccpa"}}">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="choice" value="opt-in">
            <button type="submit" class="btn btn-secondary">{{t .Lang "privacy.ccpa_opt_in_button"}}</button>
          </form>
          {{ else }}
          <form method="post" action="{{path "/server/ccpa"}}">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="choice" value="opt-out">
            <button type="submit" class="btn btn-primary">{{t .Lang "privacy.ccpa_opt_out_button"}}</button>
          </form>
          {{ end }}
        </div>

        <p>{{t .Lang "privacy.ccpa_note"}}</p>
      </section>
      {{ end }}
      {{if $privacy := operatorHTML "privacy"}}<section id="operator-extension" class="section-card" aria-labelledby="operator-extension-heading"><h2 id="operator-extension-heading">{{t .Lang "common.details"}}</h2>{{$privacy}}</section>{{end}}

      <section id="contact" class="section-card" aria-labelledby="contact-heading">
        <h2 id="contact-heading">{{t .Lang "privacy.contact_heading"}}</h2>
        <p>{{t .Lang "privacy.contact_intro"}} <a href="{{path "/server/dpo"}}">{{t .Lang "privacy.contact_link"}}</a>.</p>
      </section>
    </article>
  </div>
</main>
{{end}}

{{define "page_scripts"}}

{{end}}

{{template "public.tmpl" .}}
