{{define "page_head"}}
<meta name="description" content="WHOIS result for {{.Query}}">
<title>{{.Query}} — {{.Name}}</title>
{{end}}

{{define "page_content"}}
<main id="main-content">
  <div class="container container-sm">
    {{if .ConsentRequired}}<p role="status"><a href="{{path "/server/preferences#privacy"}}">{{t .Lang "preferences.consent_required"}}</a></p>{{end}}
    <header class="page-header">
      <h1 class="page-title">{{t .Lang "whois.title"}}</h1>
      <p class="page-lead"><span class="visually-hidden">{{t .Lang "whois.query_label"}} </span><span class="long-string">{{.Query}}</span></p>
    </header>
    <section class="section-card" aria-labelledby="lookup-heading">
      <h2 id="lookup-heading">{{t .Lang "whois.query_label"}}</h2>
      <form id="whois-form" class="stack" action="{{path "/whois"}}" method="GET" novalidate data-api-base="{{.APIBase}}">
        <div class="form-group">
          <label class="form-group-label" for="q">{{t .Lang "whois.query_label"}}</label>
          <input id="q" name="q" type="text" class="input" placeholder="{{t .Lang "whois.placeholder"}}"
            autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false" value="{{.Query}}">
        </div>
        <div class="form-actions"><button type="submit" class="btn btn-primary">{{t .Lang "whois.button"}}</button></div>
      </form>
    </section>
    {{if .Err}}
      <div class="alert alert-error" role="alert">{{.Err}}</div>
    {{else if .Result}}
      <section class="section-card" aria-labelledby="whois-result-heading">
        <h2 id="whois-result-heading">{{t .Lang "common.details"}}</h2>
        <dl class="info-list">
          <dt class="info-label">{{t .Lang "whois.result_query"}}</dt><dd class="info-value long-string">{{.Result.Query}}</dd>
          <dt class="info-label">{{t .Lang "whois.result_type"}}</dt><dd class="info-value"><span class="badge badge-info">{{.Result.Type}}</span></dd>
          <dt class="info-label">{{t .Lang "whois.result_server"}}</dt><dd class="info-value long-string">{{.Result.Server}}</dd>
          <dt class="info-label">{{t .Lang "whois.result_timestamp"}}</dt><dd class="info-value"><time datetime="{{.Result.Timestamp}}">{{.Result.Timestamp}}</time></dd>
        </dl>
        <pre class="code-block" aria-label="{{t .Lang "whois.result_raw"}}">{{.Result.Raw}}</pre>
      </section>
    {{else if .Query}}
      <div class="alert alert-error" role="alert">{{t .Lang "whois.no_result"}}</div>
    {{end}}
    <p><a href="{{path "/"}}">{{t .Lang "whois.new_lookup"}}</a></p>
  </div>
</main>
{{end}}

{{define "page_scripts"}}{{end}}
{{template "public.tmpl" .}}
