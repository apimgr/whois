{{define "page_head"}}
<meta name="description" content="{{t .Lang "errors.page_description"}}">
<title>{{t .Lang .TitleKey}} — {{.AppName}}</title>
{{end}}

{{define "page_content"}}
<main id="main-content">
  <div class="container container-md">
    <header class="page-header"><h1 class="page-title">{{t .Lang .TitleKey}}</h1><p class="page-lead">{{t .Lang "errors.page_description"}}</p></header>
    <section class="section-card" aria-labelledby="error-heading" role="alert">
      <h2 id="error-heading">{{t .Lang "errors.page_heading"}}</h2>
      <p>{{t .Lang .MessageKey}}</p>
      <p><a class="btn btn-primary" href="{{path "/"}}">{{t .Lang "errors.home_action"}}</a></p>
      <p><a href="{{path "/server/help"}}">{{t .Lang "errors.help_action"}}</a></p>
    </section>
  </div>
</main>
{{end}}

{{define "page_scripts"}}

{{end}}

{{template "public.tmpl" .}}
